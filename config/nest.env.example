# Copy to config/nest.env and edit locally. Do not commit the real file.

# Local reconstructed source trees created by scripts/bootstrap.sh.
NEST_WORK_DIR=/absolute/path/to/NEST/work

# CSD/FPGA toolchain.
VIVADO_2020_SETTINGS=/opt/Xilinx_2020.2/Vivado/2020.2/settings64.sh
CSD_ARM_HOST=arm-board.example.org
CSD_ARM_USER=root

# Remote HPU service.
HPU_REMOTE_HOST=hpu-server.example.org
HPU_REMOTE_SSH_PORT=2222
HPU_REMOTE_USER=your-user
HPU_REMOTE_TFHE_RS=/home/your-user/hpu/tfhe-rs
HPU_REMOTE_BIND=0.0.0.0:19090
HPU_REMOTE_ENDPOINT=hpu-server.example.org:19090

# V80 variables are intentionally placeholders.
HPU_BACKEND_DIR=/path/to/tfhe-rs/backends/tfhe-hpu-backend
XILINX_VIVADO=/path/to/Vivado
HPU_CONFIG=v80
V80_PCIE_DEV=xx
V80_SERIAL_NUMBER=REPLACE_ME
AMI_PATH=/path/to/AMI/driver

# Generate these files locally; do not add them to Git.
LWE_SECRET_KEY_FILE=/secure/path/psi64_big_lwe_secret_key.bin
TFHE_CLIENT_KEY_FILE=/secure/path/psi64_shortint_client_key.bincode
TFHE_SERVER_KEY_FILE=/secure/path/psi64_integer_compressed_server_key.bincode
